{
  "name": "shelflife-monorepo",
  "version": "1.0.0",
  "description": "ShelfLife Library Management System Monorepo",
  "private": true,
  "scripts": {
    "setup": "npm --prefix backend install && npm --prefix frontend install",
    "backend:dev": "npm --prefix backend run dev",
    "backend:dev-memory": "npm --prefix backend run dev:memory",
    "backend:test": "npm --prefix backend test",
    "backend:seed": "npm --prefix backend run seed",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build"
  }
}
